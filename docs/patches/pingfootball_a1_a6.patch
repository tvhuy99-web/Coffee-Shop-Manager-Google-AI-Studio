-    } else {
-        c.state_mut().team_mut(defend).tackles_won += 1;
-        c.emit(
-            EventType::TackleWon,
-            Some(defend),
-            Some(defender_id),
-            Some(attacker_id),
-            vec![kv("clean", true)],
