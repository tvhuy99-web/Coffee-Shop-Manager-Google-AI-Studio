diff --git a/app/src/main/java/pl/mkrstudio/truefootball3/lab/PresentationBoundary.kt b/app/src/main/java/pl/mkrstudio/truefootball3/lab/PresentationBoundary.kt
new file mode 100644
index 0000000..1fb8d55
--- /dev/null
+++ b/app/src/main/java/pl/mkrstudio/truefootball3/lab/PresentationBoundary.kt
@@ -0,0 +1,29 @@
+package pl.mkrstudio.truefootball3.lab
+
+/**
+ * Phase A6 explicit Android presentation module boundaries:
+ * - [MatchPlaybackBoundary]: session/JNI worker, event frontier, timeline, checkpointing.
+ * - [MatchCommentaryBoundary]: committed MatchEvent -> bilingual cue plan & FIFO TTS.
+ * - [MatchAudioBoundary]: pitch SFX, stadium ambience, sound pack & ducking.
+ *
+ * Keeps `LabReferenceMatchActivity` strictly as a UI binder while preserving existing
+ * package names for `app/build.gradle` `validateCommentaryTokens` and JVM regression tests.
+ */
+interface MatchPlaybackBoundary {
+    fun pause()
+    fun resume()
+    fun setPlaybackRate(rate: Float)
+    fun submitCommandJson(commandJson: String, onResult: (ok: Boolean, responseJson: String) -> Unit)
+    fun release()
+}
+
+interface MatchCommentaryBoundary {
+    fun isEnabled(): Boolean
+    fun release()
+}
+
+interface MatchAudioBoundary {
+    fun pauseAll()
+    fun resumeAll()
+    fun release()
+}
