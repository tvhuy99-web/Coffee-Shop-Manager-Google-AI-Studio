-        r.energy = fstate.energy;
-        r.workload = fstate.workload.min(i32::MAX as i64) as i32;
-        r.distance_covered_tenths = fstate.distance_tenths.min(i32::MAX as i64) as i32;
-        r.fatigue_accumulator = fstate.fatigue_accumulator;
