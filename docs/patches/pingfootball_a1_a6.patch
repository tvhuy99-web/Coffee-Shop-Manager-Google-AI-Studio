-            Task::Idle
-        };
-        let mut fstate = FatigueState {
-            energy: r.energy,
-            workload: r.workload as i64,
-            distance_tenths: r.distance_covered_tenths as i64,
-            fatigue_accumulator: r.fatigue_accumulator,
-            acute_fatigue: r.acute_fatigue,
