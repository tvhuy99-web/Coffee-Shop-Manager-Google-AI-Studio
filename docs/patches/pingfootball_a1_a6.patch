-fn infer_slot_position(s: &TacticalSlotSnapshot) -> &'static str {
-    let (x, y) = (s.out_x, s.out_y);
-    if y <= 11 { return "GK"; }
-    if y <= 30 {
-        if x <= 24 { return "LB"; }
-        if x >= 76 { return "RB"; }
-        return "CB";
-    }
-    if y <= 36 && (x <= 20 || x >= 80) { return if x < 50 { "LWB" } else { "RWB" }; }
-    if y <= 44 { return "DM"; }
-    if y <= 60 {
-        if x <= 24 { return "LM"; }
-        if x >= 76 { return "RM"; }
-        return "CM";
-    }
-    if y <= 72 {
-        if x <= 22 { return "LW"; }
-        if x >= 78 { return "RW"; }
-        return "AM";
-    }
-    "CF"
-}
