-pub fn circulation_bonus(
-    build_risk: i32,
-    tempo: i32,
-    sequence_passes: i32,
-    box_attack: bool,
-    transition: bool,
-) -> f64 {
-    if transition || box_attack {
-        return 0.0;
-    }
-    let patient = (60 - build_risk).max(0) as f64 * 0.060 + (55 - tempo).max(0) as f64 * 0.040;
-    let early = (1.0 - sequence_passes as f64 / 7.0).max(0.0);
-    4.2_f64.min(patient * early)
-}
