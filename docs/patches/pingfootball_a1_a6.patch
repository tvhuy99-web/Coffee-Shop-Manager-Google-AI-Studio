-        for (i, p) in self.commands.iter().enumerate() {
-            if p.command.game_second > now {
-                break;
-            }
-            if p.command.kind == CommandType::Substitute && !self.substitution_can_apply_now() {
-                continue;
-            }
-            return Some(i);
-        }
-        None
-    }
