-            CommandType::ChangeTempo => self.apply_team_instruction(&cmd, "TEMPO").map(|_| "TACTIC_APPLIED"),
-            CommandType::ChangeWidth => self.apply_team_instruction(&cmd, "WIDTH").map(|_| "TACTIC_APPLIED"),
