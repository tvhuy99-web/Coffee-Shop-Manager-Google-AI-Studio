-    let mut best: Option<String> = None;
-    let mut best_score = f64::INFINITY;
-    let mut existing_cover = false;
-    for (_, r) in &state.players {
-        if !r.on_pitch || r.side != defending_side || gk_id == Some(r.player_id.as_str()) {
