-        let score = geometry::distance(r.x, r.y, ball_x, ball_y)
-            + (r.x - 50).abs() as f64 * 0.08
-            + (r.y - goal_y).abs() as f64 * 0.03;
-        if best.is_none() || score < best_score || (score == best_score && r.player_id < *best.as_ref().unwrap()) {
