-fn delivery_quality(intent: &str) -> i32 {
-    let marker = ":QUALITY:";
-    match intent.find(marker) {
-        Some(idx) => intent[idx + marker.len()..].parse::<i32>().map(|v| v.clamp(10, 95)).unwrap_or(50),
-        None => 50,
-    }
-}
