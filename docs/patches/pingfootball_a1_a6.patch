-            CommandType::ChangeSlotInstruction => self.apply_slot_instruction(&cmd).map(|_| "SLOT_TACTIC_APPLIED"),
-            CommandType::ChangeShape => self.apply_shape(&cmd).map(|_| "SHAPE_APPLIED"),
