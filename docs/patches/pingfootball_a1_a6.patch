-            FatigueInput {
-                duration_seconds: fatigue_duration,
-                distance_tenths,
-                tempo: instr.tempo,
-                pressing_intensity: instr.pressing_intensity,
-                transition_risk: instr.transition_risk,
-                active_outfield: active_out,
-                stamina: player.attributes.get(11) as i32,
-                task,
