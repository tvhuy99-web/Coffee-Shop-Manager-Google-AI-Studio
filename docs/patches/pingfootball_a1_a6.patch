-        BallControl::Loose => {
-            duel_resolver::resolve_loose_ball(c);
-        }
-        BallControl::Airborne => {
-            duel_resolver::resolve_airborne(c);
-        }
-        BallControl::Controlled => {
-            resolve_controlled(c);
-        }
-    }
