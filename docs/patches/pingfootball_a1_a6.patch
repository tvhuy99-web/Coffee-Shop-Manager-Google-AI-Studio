+//! Phase A3 Engine Observation Builder and `SpatialForecastPort` adapter.
+//!
+//! Bridges authoritative `MatchStateV4`/`MatchInputV4` into read-only compatibility
+//! observations for `player_intelligence` and `coach_intelligence` while delegating
+//! spatial/timing math to `v4::movement`, `v4::rules`, and `v4::spatial`.
+//!
+//! Temporary compatibility exception (ADR-004 / HC-02 vs HC-03):
+//! During Phase A, `CompatibilityPlayerObservation` exposes read-only references needed
+//! to preserve bit-exact parity with baseline `c2c392d8`. Full finite-perception filtering
+//! (vision cone, occlusion, memory decay, hidden attribute stripping) closes this exception in B2.
+
+use crate::contracts::{
+    BallFlightKindContract, DurationMs, LocalContextQuery, LocalContextView, PassReachForecast,
+    PassReachQuery, SimTimeMs, SpatialForecastPort, TackleGeometryForecast, TackleGeometryQuery,
+    TeamSideV4,
+};
+use crate::v4::input::MatchInputV4;
+use crate::v4::movement::evaluate_local_context;
+use crate::v4::rules::{nominal_ball_flight_ms, BallFlightKind};
+use crate::v4::spatial::is_in_attacking_penalty_box;
+use crate::v4::state::MatchStateV4;
+
+/// Read-only compatibility observation handed by `match_engine` to `player_intelligence`.
+pub struct CompatibilityPlayerObservation<'a> {
+    pub observed_at_ms: SimTimeMs,
+    pub actor_idx: usize,
+    pub state: &'a MatchStateV4,
+    pub input: &'a MatchInputV4,
+}
+
+impl<'a> CompatibilityPlayerObservation<'a> {
+    pub fn build(state: &'a MatchStateV4, input: &'a MatchInputV4, actor_idx: usize) -> Self {
+        Self {
+            observed_at_ms: state.des_clock.sim_time_ms,
+            actor_idx,
+            state,
+            input,
+        }
+    }
+}
+
+/// Read-only compatibility observation handed by `match_engine` to `coach_intelligence`.
+pub struct CompatibilityCoachObservation<'a> {
+    pub observed_at_ms: SimTimeMs,
+    pub side: TeamSideV4,
+    pub state: &'a MatchStateV4,
+    pub input: &'a MatchInputV4,
+}
+
+impl<'a> CompatibilityCoachObservation<'a> {
+    pub fn build(state: &'a MatchStateV4, input: &'a MatchInputV4, side: TeamSideV4) -> Self {
+        Self {
+            observed_at_ms: state.des_clock.sim_time_ms,
+            side,
+            state,
+            input,
+        }
+    }
+}
+
+/// Engine-owned adapter implementing `SpatialForecastPort` for `player_intelligence`.
+pub struct EngineForecastAdapter<'a> {
+    state: &'a MatchStateV4,
+    input: &'a MatchInputV4,
+}
+
+impl<'a> EngineForecastAdapter<'a> {
+    pub fn new(state: &'a MatchStateV4, input: &'a MatchInputV4) -> Self {
+        Self { state, input }
+    }
+
+    fn map_flight_kind(kind: BallFlightKindContract) -> BallFlightKind {
+        match kind {
+            BallFlightKindContract::GroundPass => BallFlightKind::ShortPass,
+            BallFlightKindContract::ThroughPass => BallFlightKind::ThroughPass,
+            BallFlightKindContract::LoftedPass => BallFlightKind::LongPass,
+            BallFlightKindContract::Cross => BallFlightKind::Cross,
+            BallFlightKindContract::Clearance => BallFlightKind::Clearance,
+            BallFlightKindContract::Shot => BallFlightKind::DrivenShot,
+        }
+    }
+}
+
+impl<'a> SpatialForecastPort for EngineForecastAdapter<'a> {
+    fn estimate_pass_reach(&self, query: &PassReachQuery) -> PassReachForecast {
+        let dist = query.passer_pos.distance(query.target_pos);
+        let flight_ms = self.nominal_flight_ms(query.flight_kind, dist);
+        let ctx = evaluate_local_context(
+            self.state,
+            self.input,
+            query.attacking_side,
+            query.target_pos,
+        );
+        PassReachForecast {
+            estimated_flight_ms: flight_ms,
+            interception_risk: (ctx.pressure / 100.0).clamp(0.0, 1.0),
+            lane_clearance_m: ctx.nearest_defender_dist_m,
+            receiver_margin_m: ctx.nearest_defender_dist_m,
+        }
+    }
+
+    fn evaluate_local_context(&self, query: &LocalContextQuery) -> LocalContextView {
+        let ctx = evaluate_local_context(self.state, self.input, query.side, query.point);
+        let nearby_opponents = self
+            .state
+            .players
+            .iter()
+            .filter(|p| p.on_pitch && p.side != query.side && p.pos.distance(query.point) <= 8.0)
+            .count() as u8;
+        let nearby_teammates = self
+            .state
+            .players
+            .iter()
+            .filter(|p| p.on_pitch && p.side == query.side && p.pos.distance(query.point) <= 8.0)
+            .count() as u8;
+        LocalContextView {
+            nearest_opponent_m: ctx.nearest_defender_dist_m,
+            pressure_score: ctx.pressure,
+            nearby_opponents,
+            nearby_teammates,
+        }
+    }
+
+    fn estimate_tackle_geometry(&self, query: &TackleGeometryQuery) -> TackleGeometryForecast {
+        let dist = query.tackler_pos.distance(query.carrier_pos);
+        let reach_prob = (1.0 - (dist / 4.5)).clamp(0.0, 1.0);
+        let body_risk = (0.35 * reach_prob).clamp(0.0, 1.0);
+        let in_box = is_in_attacking_penalty_box(query.attacking_side, query.carrier_pos);
+        TackleGeometryForecast {
+            distance_m: dist,
+            reach_probability: reach_prob,
+            body_contact_risk: body_risk,
+            in_penalty_box: in_box,
+        }
+    }
+
+    fn nominal_flight_ms(&self, kind: BallFlightKindContract, distance_m: f32) -> DurationMs {
+        nominal_ball_flight_ms(
+            &self.input.timing_model,
+            distance_m,
+            Self::map_flight_kind(kind),
+            self.input.match_environment.weather,
+            self.input.match_environment.pitch_quality,
+        )
+    }
+}
