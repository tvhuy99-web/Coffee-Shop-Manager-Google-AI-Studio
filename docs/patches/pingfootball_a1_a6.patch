-        }
-        loop {
-            items.push(self.parse_value()?);
-            match self.peek() {
-                Some(b',') => self.pos += 1,
-                Some(b']') => { self.pos += 1; break; }
-                _ => return Err(format!("expected ',' or ']' at {}", self.pos)),
-            }
-        }
