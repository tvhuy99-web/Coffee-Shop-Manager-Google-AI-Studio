-        if advantage {
-            c.state_mut().team_mut(attack).dribbles_won += 1;
-            c.emit(
-                EventType::DribbleWon,
-                Some(attack),
-                Some(attacker_id),
-                Some(defender_id),
-                vec![kv("advantage", true)],
-            );
-        }
-        return;
-    }
-
-    c.emit(
-        EventType::GroundDuel,
-        Some(attack),
-        Some(attacker_id),
-        Some(defender_id),
-        vec![kv("attackerScore", atk as i32), kv("defenderScore", def as i32)],
