-    h = fp::mix_i64(h, state.possession.sequence_id);
-    h = fp::mix_i32(h, side as i32);
-    h = fp::mix_string(h, Some(slot_id));
-    h = fp::mix_i32(h, salt);
-    if (h & 1) == 0 { -1 } else { 1 }
-}
