-    let active = player
-        .as_deref()
-        .and_then(|id| c.state().player(id))
-        .map(|r| r.on_pitch)
-        .unwrap_or(false);
-    if !active {
-        player = nearest_outfield(c, side, x, y);
-    }
-    let player_id = match player {
-        Some(id) => id,
-        None => return,
-    };
-    if let Some(r) = c.state_mut().player_mut(&player_id) {
