-    fn resolve_penalty_shootout(&mut self) {
-        let first = if self.rng.next_boolean() { TeamSide::Home } else { TeamSide::Away };
-        let home_active = roster::active_player_ids_in_slot_order(&self.input, &self.state, TeamSide::Home).len();
