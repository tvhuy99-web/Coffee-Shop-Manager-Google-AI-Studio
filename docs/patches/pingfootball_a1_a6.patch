-fn weighted(values: &[u8], weights: &[i32]) -> i32 {
-    let (mut sum, mut total) = (0i32, 0i32);
-    for (&v, &w) in values.iter().zip(weights.iter()) {
-        sum += (v as i32) * w;
-        total += w;
-    }
-    if total == 0 {
-        return 0;
-    }
-    ((sum as f32 / total as f32).round() as i32).clamp(1, 99)
