diff --git a/tools/check_workspace_dag.py b/tools/check_workspace_dag.py
new file mode 100755
index 0000000..afcea0a
--- /dev/null
+++ b/tools/check_workspace_dag.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Verifies Cargo Workspace production dependency DAG via `cargo metadata --format-version 1`."""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+RUST_DIR = ROOT / "rust"
+
+ALLOWED_INTERNAL_DEPS = {
+    "match_engine": set(),
+    "football_match_engine_jni": {"match_engine"},
+}
+FORBIDDEN_EXTERNAL_DEPS = {
+    "match_engine": {"jni"},
+}
+
+def main() -> int:
+    res = subprocess.run(
+        ["cargo", "metadata", "--format-version", "1", "--no-deps"],
+        cwd=RUST_DIR,
+        capture_output=True,
+        text=True,
+    )
+    if res.returncode != 0:
+        print("ERROR: cargo metadata failed:\n" + res.stderr, file=sys.stderr)
+        return 2
+    meta = json.loads(res.stdout)
+    workspace_names = {p["name"] for p in meta["packages"]}
+    errors = []
+    for pkg in meta["packages"]:
+        name = pkg["name"]
+        prod_deps = [d["name"] for d in pkg["dependencies"] if d.get("kind") is None]
+        internal = {d for d in prod_deps if d in workspace_names}
+        allowed = ALLOWED_INTERNAL_DEPS.get(name, set())
+        if not internal.issubset(allowed):
+            errors.append(f"{name}: disallowed internal deps {sorted(internal - allowed)} (allowed: {sorted(allowed)})")
+        forbidden_ext = FORBIDDEN_EXTERNAL_DEPS.get(name, set()) & set(prod_deps)
+        if forbidden_ext:
+            errors.append(f"{name}: forbidden external deps {sorted(forbidden_ext)}")
+    if errors:
+        for e in errors:
+            print("DAG FAIL:", e, file=sys.stderr)
+        return 1
+    print(f"DAG PASS: verified {len(workspace_names)} workspace crates: {sorted(workspace_names)}")
+    return 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
